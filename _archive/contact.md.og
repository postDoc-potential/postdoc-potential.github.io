            width: 65%;
            margin-left: 17%;
            margin-top: 5%;
        }

        .lt {
            width: 55%;
            display: inline-block;
            float: left;
            margin-right: 0;
        }

        .rt {
            width: 35%;
            display: inline-block;
            margin-left: 0;
        }

        .list-item {
            margin-bottom: 10%;
        }

        .contact-list {
            margin-top: 22%;
            padding-right: 8%;
        }

        .fa-envelope, .gmail {
            display: inline-block;
            width: auto;
        }
    }

    .column {
        float: left;
        width: 50%;
    }

    /* Clear floats after the columns */
    .row:after {
        content: "";
        display: table;
        clear: both;
    }
    #result {
        margin-top: 15px;
        font-weight: bold;
        text-align: center;
    }
</style>

<head>
    <link rel="stylesheet" 
          href="https://maxcdn.bootstrapcdn.com/bootstrap/4.4.1/css/bootstrap.min.css" />
    <link rel="stylesheet" 
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" />
    <link rel="stylesheet" 
          href="style.css" />
</head>

# Contact us

<div class="row">
    <div class="column">
        <h2>To get in touch</h2>
        <p>For collaboration, volunteering and participation drop us an email</p>
        <button class="btn success">
            <p> <img src="assets/img/icons8-email-32.png" style="vertical-align:middle"><b> Email </b><a href="mailto:postdoc.potential@gmail.com" target="_blank">postdoc.potential@gmail.com</a></p>
        </button>
        <h2> Our partners</h2>
        <button class="btn success">
            <h3 style=" font-size: 20px;vertical-align:center">Climate Dialogues: Way Forward (CDWF)</h3>
            <p> <img src="assets/img/icons8-email-32.png" style="vertical-align:middle"><b> Email </b><a href="mailto: climatedialogueswayforward@gmail.com " target="_blank"> climatedialogueswayforward@gmail.com</a></p>
        </button>
    </div>
    <div class="column">
        <section id="last">
            <div class="full">
                <h3>Drop a Message</h3>
                <div class="lt">
                    <form class="form-horizontal"
                        action="https://api.web3forms.com/submit"
                        method="POST">
                        <!-- <form id="contact-form" class="form-horizontal"> -->
                        <!-- Web3Forms Access Key -->
                        <input type="hidden" name="access_key"
                        value="073cc7af-bd2e-45fb-a3f4-4ec638461a14">
                        <!-- Optional Subject -->
                        <!-- <input type="hidden" name="subject"
                            value="New Message from PostDoc Potential Website"> -->
                        <!-- Optional Redirect after submission
                        <input type="hidden" name="redirect"
                            value="https://postdoc-potential.github.io/thank-you.html"> -->
                        <div class="form-group">
                            <div class="col-sm-12">
                                <input type="text"
                                    class="form-control"
                                    id="name"
                                    name="name"
                                    placeholder="NAME"
                                    required>
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-sm-12">
                                <input type="email"
                                    class="form-control"
                                    id="email"
                                    name="email"
                                    placeholder="EMAIL"
                                    required>
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-sm-12">
                                <textarea class="form-control"
                                        rows="10"
                                        name="message"
                                        placeholder="MESSAGE"
                                        required></textarea>
                            </div>
                        </div>
                        <!-- Anti-spam field -->
                        <input type="checkbox"
                            name="botcheck"
                            class="hidden"
                            style="display:none;">
                        <button class="btn btn-primary send-button"
                                type="submit">
                            <i class="fa fa-paper-plane"></i>
                            <span class="send-text">SEND</span>
                        </button>
                    </form>
                    <!-- <div id="result"></div> -->
                </div>
            </div>
        </section>
    </div>
</div>
<br>

<!-- ### [back](./) -->

<script>
    const form = document.getElementById('form');
    const submitBtn = form.querySelector('button[type="submit"]');

    form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const formData = new FormData(form);
        formData.append("access_key", "073cc7af-bd2e-45fb-a3f4-4ec638461a14");

        const originalText = submitBtn.textContent;

        submitBtn.textContent = "Sending...";
        submitBtn.disabled = true;

        try {
            const response = await fetch("https://api.web3forms.com/submit", {
                method: "POST",
                body: formData
            });

            const data = await response.json();

            if (response.ok) {
                alert("Success! Your message has been sent.");
                form.reset();
            } else {
                alert("Error: " + data.message);
            }

        } catch (error) {
            alert("Something went wrong. Please try again.");
        } finally {
            submitBtn.textContent = originalText;
            submitBtn.disabled = false;
        }
    });
</script>