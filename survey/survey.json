{
  "title": "Earth Sciences Career Workshop Survey",
  "completedHtml": "<h4 align=center> Submitted!</h4>\n\n<p> Thank you for taking the time to complete <b>Earth Sciences Career Workshop Survey</b>.<br> \n\nFor any feedback or queries, please email us at <a href=' mailto:postdoc.potential@gmail.com' target=\"_blank\"> postdoc.potential@gmail.com</a>.<br>\nVisit <a href=' https://postdoc-potential.github.io/' target=\"_blank\"> postdoc-potential.github.io</a> for more information.<br>\nHave a great day!<p>",
